APP_ENV=development
DATABASE_URL=postgresql+asyncpg://newsbot:CHANGE_THIS_PASSWORD@localhost:5432/newsbot

# ── Gemini API Keys (Multi-Project Key Pool for ISS-020) ──
# IMPORTANT: Google Free Tier quotas are enforced per-project, NOT per-key.
# Keys MUST belong to different Google Cloud projects (or accounts) to multiply quota limits.
GEMINI_KEY_1=AIza...
GEMINI_KEY_2=AIza...
GEMINI_KEY_3=AIza...
# Legacy single key (backward compatibility):
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Gemini Models (Quality-First Architecture) ──
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLE_FALLBACK=false

# ── SQLite Key Rotation Persistence ──
GEMINI_KEY_DB_PATH=data/gemini_keys.db

# ── Telegram Delivery ──
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_ADMIN_CHAT_ID=123456789

# ── Scheduling & System Defaults ──
TIMEZONE=Asia/Tehran
COLLECTION_INTERVAL_MINUTES=60
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
MAX_ARTICLES_PER_BATCH=50
MIN_IMPORTANCE=2
