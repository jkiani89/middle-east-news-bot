APP_ENV=development
# ── PostgreSQL Database (Aiven Free PostgreSQL or Local Docker) ──
# Free tier PostgreSQL 16 on aiven.io (1 CPU, 1GB RAM, 1GB storage, max 20 connections).
# Copy the Service URI from Aiven console and change protocol to postgresql+asyncpg://
# Format: postgresql+asyncpg://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DATABASE_URL=postgresql+asyncpg://avnadmin:CHANGE_THIS_PASSWORD@localhost:5432/defaultdb?sslmode=require

# ── Gemini API Keys (Multi-Project Key Pool for ISS-020) ──
# IMPORTANT: Google Free Tier quotas are enforced per-project, NOT per-key.
# Keys MUST belong to different Google Cloud projects (or accounts) to multiply quota limits.
# Option 1 (Comma-separated list in a single variable):
GEMINI_API_KEY=AIzaSyProject1..., AIzaSyProject2..., AIzaSyProject3...
# Option 2 (Separate numbered variables):
# GEMINI_KEY_1=AIza...
# GEMINI_KEY_2=AIza...
# GEMINI_KEY_3=AIza...

# ── Gemini Models (Quality-First Architecture) ──
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLE_FALLBACK=false

# ── Gemini Request Log Retention ──
# Days to keep rows in gemini_request_log table.
# A daily job at 03:00 Tehran deletes rows older than this.
GEMINI_LOG_RETENTION_DAYS=30

# ── SQLite Key Rotation Persistence (DEPRECATED in F-1) ──
# Key state now persists in PostgreSQL (gemini_suspended_keys, gemini_key_stats, gemini_request_log).
# This variable is ignored. Kept for backward compat with existing .env files.
# GEMINI_KEY_DB_PATH=data/gemini_keys.db

# ── Telegram Delivery ──
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_ADMIN_CHAT_ID=123456789

# ── Scheduling & System Defaults ──
TIMEZONE=Asia/Tehran
COLLECTION_INTERVAL_MINUTES=60
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
MAX_ARTICLES_PER_BATCH=50
MIN_IMPORTANCE=2

# ── Backup Configuration (Cloudflare R2) ──
# Requires `rclone` installed on the host and configured with a remote named "r2".
# See docs/BACKUP_RESTORE.md for setup.
R2_BUCKET_NAME=newsbot-backups
BACKUP_RETENTION_DAYS=7
